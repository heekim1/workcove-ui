FROM node:22-bookworm-slim

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . /app/

ARG APP_USER=app
ARG APP_UID=1000
RUN useradd -m -u "${APP_UID}" "${APP_USER}" && \
    chown -R "${APP_USER}:${APP_USER}" /app
USER ${APP_USER}

EXPOSE 3000
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000"]
